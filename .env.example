# LearnHub full-stack Docker configuration
# Copy this file to .env and replace every change-me value before starting.

# Public web port. Open http://localhost:8088 after startup.
APP_PORT=8088

# Database
MYSQL_DATABASE=learnhub
MYSQL_USER=learnhub
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# RabbitMQ
RABBITMQ_DEFAULT_USER=learnhub
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=learnhub
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=learnhub-docs
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Qdrant
QDRANT_COLLECTION_NAME=learnhub_docs

# OpenAI-compatible provider
API_KEY=replace-with-your-api-key
BASE_URL=https://api.siliconflow.cn
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBEDDING_MODEL=BAAI/bge-m3

# Use a long random value (at least 32 bytes). Example generator:
# powershell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION=3600000

# Java container options
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC
