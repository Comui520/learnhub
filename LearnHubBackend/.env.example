# Host ports. Change the left-side port here when Windows already uses it.
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

MYSQL_HOST=127.0.0.1
REDIS_HOST=127.0.0.1

# Local development credentials. Replace them in your real .env.
MYSQL_DATABASE=learnhub_change_me
MYSQL_USER=learnhub_change_me
MYSQL_PASSWORD=learnhub_change_me
MYSQL_ROOT_PASSWORD=learnhub_change_me

RABBITMQ_DEFAULT_USER=learnhub_change_me
RABBITMQ_DEFAULT_PASS=learnhub_change_me
RABBITMQ_HOST=localhost

MINIO_ROOT_USER=learnhub_change_me
MINIO_ROOT_PASSWORD=learnhub_change_me
MINIO_BUCKET=learnhub-docs
MINIO_ENDPOINT=http://127.0.0.1:9000

JWT_SECRET=learnhub_change_me
LOG_PATH=\logs
LOG_FILE_NAME=learnhub-log

EMBEDDING_MODEL=BAAI/bge-m3
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
API_KEY=sk-learnhub_change_me
BASE_URL=https://api.siliconflow.cn

QDRANT_HOST=localhost
QDRANT_COLLECTION_NAME=learnhub_docs
