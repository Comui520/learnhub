<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.comui520.learnhub.knowledge.mapper.KnowledgeBaseMapper">

    <select id="findByIdAndUserId"
            resultType="com.github.comui520.learnhub.knowledge.entity.KnowledgeBase">
        select *
        from `knowledge_base`
        where id = #{id}
          and user_id = #{userId}
    </select>
</mapper>